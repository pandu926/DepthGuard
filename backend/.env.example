POSTGRES_PASSWORD=replace-with-a-random-secret
APP_DB_PASSWORD=replace-with-64-random-hex-characters
POSTGRES_PORT=55439
API_PORT=8800
APP_ORIGIN=http://127.0.0.1:5174
SOLANA_CLUSTER=localnet
SOLANA_RPC_URLS=http://127.0.0.1:8899
ENABLE_CHAIN_WRITES=false
# Enable only after the three programs have been deployed on the selected localnet/devnet.
ENABLE_CONTRACTS=false
ARTIFACTS_DIR=artifacts
# Compose bind mount: create and assign ownership to uid 10001 before startup.
ARTIFACTS_HOST_DIR=./artifacts
RUST_LOG=info,tower_http=warn
# For host binaries, set DATABASE_URL using the private PostgreSQL port.
DATABASE_URL=postgres://depthguard:replace-with-a-random-secret@127.0.0.1:55439/depthguard

# Required for native launch drafts; generate with: openssl rand -hex 32
KEY_ENCRYPTION_KEY=
# Public recipient address, never a wallet private key.
PLATFORM_FEE_WALLET=
DAMM_MIGRATION_CONFIG=
# Host paths; Docker images set these automatically.
NATIVE_HELPER_PATH=./backend/native/target/debug/depthguard-native
SBF_HELPER_PATH=./backend/sbf/target/debug/depthguard-sbf
SBF_FIXTURES_DIR=./proof/fixtures
# Encrypted off-host backups; configure in a private service environment.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
