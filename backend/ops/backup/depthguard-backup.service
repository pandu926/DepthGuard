[Unit]
Description=DepthGuard encrypted off-host backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/depthguard/backup.env
WorkingDirectory=/opt/depthguard
ExecStart=/usr/bin/python3 /opt/depthguard/backend/ops/backup/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/depthguard /var/cache/restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
