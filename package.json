{
  "name": "depthguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --config web/vite.config.mjs",
    "server": "ts-node server/src/index.ts",
    "web": "vite --config web/vite.config.mjs",
    "check": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build": "vite build --config web/vite.config.mjs",
    "test": "ts-node tests/integration.ts",
    "test:proof": "npm --prefix proof test",
    "fixtures": "npm --prefix proof run fixtures",
    "demo": "ts-node scripts/demo.ts",
    "backend:build": "cargo build --manifest-path backend/Cargo.toml --locked && cargo build --manifest-path backend/native/Cargo.toml --locked && cargo build --manifest-path backend/sbf/Cargo.toml --locked",
    "backend:test": "cargo test --manifest-path backend/Cargo.toml --locked && cargo test --manifest-path backend/native/Cargo.toml --locked",
    "backend:proof": "python3 backend/scripts/fetch-fixtures.py && python3 backend/scripts/verify-parity.py && node -r ts-node/register backend/scripts/native-fee-proof.cjs",
    "backend:e2e": "node -r ts-node/register backend/scripts/http-lifecycle.cjs",
    "backend:contract": "cargo run --manifest-path backend/Cargo.toml --locked -p depthguard-api -- contract > backend/openapi.json && openapi-typescript backend/openapi.json -o web/src/generated/backend-api.ts",
    "contracts:build": "bash contracts/scripts/build.sh",
    "contracts:test": "bash contracts/scripts/test.sh",
    "contracts:security": "cargo clippy --manifest-path contracts/Cargo.toml --all-targets --locked -- -D warnings && cargo audit --file contracts/Cargo.lock && cargo audit --file contracts/tests/runner/Cargo.lock",
    "web:test": "vitest run --config web/vitest.config.ts",
    "web:onboarding:test": "node web/tests/onboarding.cjs",
    "web:e2e": "node web/tests/lifecycle.cjs",
    "web:devnet:preflight": "node web/scripts/devnet-preflight.mjs",
    "contracts:devnet:preflight": "node contracts/scripts/devnet.cjs preflight",
    "contracts:devnet:deploy": "node contracts/scripts/devnet.cjs deploy",
    "contracts:devnet:verify": "node contracts/scripts/devnet.cjs verify",
    "web:devnet:e2e": "DEPTHGUARD_ACCEPTANCE_CLUSTER=devnet node web/tests/lifecycle.cjs",
    "web:devnet:frontend": "node web/tests/frontend-devnet.cjs",
    "web:transport:test": "node --test web/tests/transport.mjs",
    "repo:check": "node scripts/check-repository.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@hookform/resolvers": "5.2.2",
    "@solana/wallet-standard-features": "1.3.0",
    "@solana/web3.js": "1.98.4",
    "@tanstack/react-query": "5.90.2",
    "@wallet-standard/app": "1.1.0",
    "@wallet-standard/base": "1.1.0",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "katex": "0.19.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.63.0",
    "react-router-dom": "7.18.4",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@playwright/test": "1.55.1",
    "@solana/spl-token": "0.4.14",
    "@types/bn.js": "5.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "decimal.js": "10.6.0",
    "fastify": "5.12.5",
    "litesvm": "0.1.0",
    "openapi-typescript": "7.13.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "description": "Reusable token economy models on Solana, powered by Meteora DBC, DAMM v2, and Dynamic Fee Sharing.",
  "engines": {
    "node": ">=22 <23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandu926/DepthGuard.git"
  },
  "homepage": "https://depthguard.rbexp.com",
  "bugs": {
    "url": "https://github.com/pandu926/DepthGuard/issues"
  }
}
